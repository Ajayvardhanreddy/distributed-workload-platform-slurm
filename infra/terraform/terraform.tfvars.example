# Copy this file to terraform.tfvars and fill in your real values.
# terraform.tfvars is gitignored (it contains your IP); this .example is tracked.

aws_region       = "us-east-1"
allowed_ssh_cidr = "YOUR.PUBLIC.IP/32" # e.g. "203.0.113.10/32" — a SINGLE IP, /32
public_key_path  = "~/.ssh/slurm-lab.pub"
